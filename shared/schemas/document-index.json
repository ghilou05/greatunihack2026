{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-index.json",
  "title": "DocumentIndex",
  "type": "object",
  "required": ["document_id", "pages", "spans"],
  "properties": {
    "document_id": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "width", "height"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "width": { "type": "number" },
          "height": { "type": "number" }
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["span_id", "unit_kind", "page", "text", "bbox"],
        "properties": {
          "span_id": { "type": "string", "description": "Line-level unit id, e.g. p1_l0" },
          "unit_kind": { "type": "string", "enum": ["line"] },
          "page": { "type": "integer", "minimum": 1, "description": "1-based page number" },
          "text": { "type": "string" },
          "bbox": {
            "type": "object",
            "required": ["x0", "y0", "x1", "y1"],
            "properties": {
              "x0": { "type": "number" },
              "y0": { "type": "number" },
              "x1": { "type": "number" },
              "y1": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
