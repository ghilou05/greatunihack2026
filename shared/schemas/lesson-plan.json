{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson-plan.json",
  "title": "LessonPlan",
  "type": "object",
  "required": ["lesson_id", "document_id", "title", "segments"],
  "properties": {
    "lesson_id": { "type": "string" },
    "document_id": { "type": "string" },
    "title": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal", "span_ids", "narration", "on_enter", "cues", "next"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "span_ids": { "type": "array", "items": { "type": "string" } },
          "narration": { "type": "string" },
          "on_enter": { "$ref": "#/$defs/segmentOnEnter" },
          "cues": {
            "type": "array",
            "description": "MVP: []. Future: timed viewer commands via TTS timestamps",
            "items": { "$ref": "#/$defs/segmentCue" }
          },
          "check_question": {
            "type": ["string", "null"],
            "description": "Post-MVP micro-check; ignore in hackathon player"
          },
          "next": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "segmentOnEnter": {
      "type": "object",
      "required": ["scroll_to_span", "highlights"],
      "properties": {
        "scroll_to_span": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } }
      }
    },
    "segmentCue": {
      "type": "object",
      "required": ["at_ms", "commands"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "commands": {
          "type": "array",
          "items": { "$ref": "viewer-commands.json" }
        }
      }
    }
  }
}
