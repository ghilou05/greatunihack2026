# Copy to backend/.env (gitignored). Defaults below mirror the design (docs/p2-solution-design.md).

# OpenAI key. Empty => lesson/Q&A routes return 503 "Lesson generator is not configured". Never commit a real key.
OPENAI_API_KEY=

# Model used for the lesson-plan call (fallbacks per design D7: gpt-6-luna, then gpt-4o-mini).
OPENAI_PLAN_MODEL=gpt-6.1-terra
# Model used for grounded Q&A (use gpt-6-luna if Q&A p50 > 5 s).
OPENAI_QA_MODEL=gpt-6.1-terra
# Reasoning effort for the plan call. Empty => omit the `reasoning` parameter (needed for non-reasoning fallback models).
OPENAI_PLAN_EFFORT=low
# Reasoning effort for the Q&A call. Empty => omit the `reasoning` parameter.
OPENAI_QA_EFFORT=low
# Optional service tier for both calls (demo-day switch, e.g. fast). Empty => omit.
OPENAI_SERVICE_TIER=

# Plan strategy: single (default). paged is only available after T-023 (latency gate).
PLAN_STRATEGY=single
# max_output_tokens for the plan call (includes reasoning tokens; x1.5 on retry after incomplete).
PLAN_MAX_OUTPUT_TOKENS=6000
# max_output_tokens for the Q&A call.
QA_MAX_OUTPUT_TOKENS=1200
# Per-call timeout in seconds for the plan call (SDK max_retries=0).
PLAN_TIMEOUT_S=45
# Per-call timeout in seconds for the Q&A call (SDK max_retries=1).
QA_TIMEOUT_S=20
# Request-wide deadline in seconds for the plan ladder.
PLAN_DEADLINE_S=80
# The ladder retry is skipped if more than this many seconds have elapsed.
PLAN_RETRY_CUTOFF_S=45

# Ingest cap: maximum number of PDF pages.
MAX_PAGES=10
# Ingest cap: maximum total extracted characters.
MAX_TOTAL_CHARS=80000
# Ingest floor: minimum total extracted characters.
MIN_TOTAL_CHARS=200
# Ingest floor: minimum number of extracted line units.
MIN_LINES=10
# Ingest cap: maximum upload size in MiB.
MAX_UPLOAD_MB=20

# Storage directory. Relative values resolve against backend/, not the process cwd.
DATA_DIR=./data
# Comma-separated CORS origins.
CORS_ORIGINS=http://localhost:3000
